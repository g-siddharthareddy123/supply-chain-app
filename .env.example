APP_NAME=Supply Chain Control Tower
APP_ENV=development
DATABASE_URL=mysql+pymysql://username:password@localhost:3306/database_name
# Optional. When set, protected business endpoints also accept this API key.
API_KEY=
# Required for JWT login. Generate a unique value with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
# Comma-separated browser origins allowed by FastAPI.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional initial planner account inputs for `python -m scripts.create_user`.
# Leave blank to be prompted for an email and hidden password.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
